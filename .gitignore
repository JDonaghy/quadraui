/target
*.swp
*.swo
.DS_Store
__pycache__/
.claude/settings.local.json
.claude/scheduled_tasks.lock
*.log

# `maturin develop`'s compiled extension, built in place under the
# pure-Python package it backs.
quadraui-py/python/quadraui/*.abi3.so
quadraui-py/python/quadraui/*.pyd
quadraui-py/.venv/

# `napi build`'s generated loader/types/native addon (`package.json`'s
# `build` script), built in place at the crate root. `quadraui-node/js/
# index.ts` is this package's hand-maintained entry point and the only one
# checked in; these three are regenerated by every `npm run build`.
quadraui-node/index.js
quadraui-node/index.d.ts
quadraui-node/*.node
quadraui-node/node_modules/
