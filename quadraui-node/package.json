{
  "name": "@quadraui/node",
  "version": "0.11.0",
  "description": "napi-rs bindings: insert quadraui descriptors from JavaScript/TypeScript and render them headlessly.",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JDonaghy/quadraui.git",
    "directory": "quadraui-node"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./app": {
      "types": "./dist/app/index.d.ts",
      "default": "./dist/app/index.js"
    },
    "./app/*": {
      "types": "./dist/app/*.d.ts",
      "default": "./dist/app/*.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "default": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-dev-runtime.d.ts",
      "default": "./dist/jsx-dev-runtime.js"
    },
    "./wire": {
      "types": "./dist/wire.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "dist/",
    "index.js",
    "index.d.ts"
  ],
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "artifacts": "napi artifacts",
    "build:dist": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node -e \"require('fs').copyFileSync('js/wire.d.ts','dist/wire.d.ts')\"",
    "prepack": "npm run build:dist",
    "test": "node --test tests/*.test.ts",
    "typecheck:jsx": "tsc -p tsconfig.jsx.json",
    "typecheck:examples": "tsc --strict --noEmit --module commonjs --target es2020 --moduleResolution node --skipLibCheck --types node examples/*.ts",
    "typecheck:dist-types": "tsc --strict --noEmit --module node16 --moduleResolution node16 --types node dist/index.d.ts dist/app/index.d.ts dist/testing.d.ts dist/jsx-runtime.d.ts dist/jsx-dev-runtime.d.ts",
    "pretest": "npm run build:dist",
    "smoke:pack": "node scripts/pack_smoke.ts"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3",
    "@types/node": "^22",
    "esbuild": "^0.28.0",
    "typescript": "^5.9.0"
  },
  "napi": {
    "binaryName": "quadraui-node",
    "packageName": "@quadraui/node",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc"
    ]
  }
}
