"""Minimal stub for the compiled `quadraui._quadraui` native extension
(`quadraui-py/src/lib.rs`, built by `maturin`/`napi`-style `#[pymethods]`).

`quadraui/__init__.py` re-exports this whole module's public API, and
`quadraui/py.typed` (PEP 561) tells a type checker to follow imports *into*
this package rather than silently skip it -- which means it now has to
resolve `quadraui._quadraui` too, and a compiled `.so`/`.pyd` has nothing
for a checker to read. Without this file a strict `mypy`/`pyright` run
against anything importing `quadraui` fails on `__init__.py`'s own `from
._quadraui import (...)` line with "Cannot find implementation or library
stub for module", before it even reaches application code.

This stub only unblocks that import -- it is not a field-by-field typing
of `QuiApp`'s full method surface (viewport/theme/run_tui/run_native/
run_shell/... — see `quadraui/__init__.py`'s own module docstring for the
list). `QuiApp`/`QuiAppWaker`/`QuiShellApp` each fall back to `__getattr__
-> Any` for every method this stub doesn't name explicitly, so a call to
one of them type-checks (permissively, as `Any`) instead of erroring with
"has no attribute" -- narrowing that surface method-by-method, the same
way `scripts/gen_wire_types.py` narrows the wire *data* shapes, is
follow-on work.
"""

from typing import Any, Callable, Mapping, Optional

class QuadrauiError(Exception): ...
class InvalidDescriptorError(QuadrauiError): ...
class SlotOccupiedError(QuadrauiError): ...
class UnknownSlotError(QuadrauiError): ...
class InvalidDimensionsError(QuadrauiError): ...
class InvalidCharError(QuadrauiError): ...
class PanicError(QuadrauiError): ...
class PoisonedError(QuadrauiError): ...
class InternalError(QuadrauiError): ...
class NativeAlreadyRunError(QuadrauiError): ...
class NoDisplayError(QuadrauiError): ...
class NotOnMainThreadError(QuadrauiError): ...
class InvalidAppIdError(QuadrauiError): ...
class InvalidFontRoleError(QuadrauiError): ...
class UnsupportedError(QuadrauiError): ...

class QuiAppWaker:
    """No public constructor -- only returned by `QuiApp.waker()`."""

    def __getattr__(self, name: str) -> Any: ...

class QuiShellApp:
    """No public constructor -- only returned by `QuiApp.run_shell(...)`."""

    def __getattr__(self, name: str) -> Any: ...

class QuiApp:
    def __init__(
        self,
        width: int,
        height: int,
        on_event: Optional[Callable[..., Any]] = ...,
        render: Optional[Callable[..., Any]] = ...,
    ) -> None: ...
    def __getattr__(self, name: str) -> Any: ...

def app_path(kind: str) -> str: ...
def set_app_identifier(identifier: str) -> None: ...
def install_crash_handler(cfg: Mapping[str, Any]) -> None: ...
