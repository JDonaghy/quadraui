class _ScrollOffsetChangedPayload(TypedDict):
    widget: WidgetId
    new_offset: int

class _TextSelectionChangedPayload(TypedDict):
    region: WidgetId
    anchor: Point
    focus: Point

class _SplitDividerDraggedPayload(TypedDict):
    tree: WidgetId
    split_index: int
    new_ratio: float

class _TrayClickedPayload(TypedDict):
    button: MouseButton

class _NotificationActivatedPayload(TypedDict):
    tag: Optional[str]
    action: Optional[WidgetId]

class RowsRequestedEvent(TypedDict):
    """The `{id, start, count}` window a virtualised `list`/`tree`/`data_table`/`text_display` widget needs for its next frame, once scrolling moves outside the slice its own `ItemsWindow` currently covers -- see `quadraui-binding-core`'s own `render::rows_requested_for_window`. Not a `quadraui::UiEvent` variant (hence not part of `_UiEventDict`/`UiEvent` below): a binding computes this itself from a leaf's `PaintedHit` and its own `ItemsWindow`, then surfaces it to its app however its own event-callback contract already surfaces a synthesized event."""
    id: WidgetId
    start: int
    count: int

class _UiEventDict(TypedDict):
    """Everything a user (or platform) can do that an app might care about -- see `quadraui/src/event.rs`'s `UiEvent`."""
    Accelerator: NotRequired[Tuple[AcceleratorId, Modifiers]]
    GlobalShortcut: NotRequired[GlobalShortcutId]
    KeyPressed: NotRequired[_UiKeyPressedPayload]
    CharTyped: NotRequired[str]
    MouseDown: NotRequired[_MouseDownPayload]
    MouseUp: NotRequired[_MouseUpPayload]
    MouseMoved: NotRequired[_MouseMovedPayload]
    MouseEntered: NotRequired[_WidgetPayload]
    MouseLeft: NotRequired[_WidgetPayload]
    DoubleClick: NotRequired[_DoubleClickPayload]
    Scroll: NotRequired[_UiScrollPayload]
    WindowResized: NotRequired[_WindowResizedPayload]
    WindowFocused: NotRequired[bool]
    DpiChanged: NotRequired[float]
    WindowStateChanged: NotRequired[_WindowStateChangedPayload]
    FilesDropped: NotRequired[_FilesDroppedPayload]
    ClipboardPaste: NotRequired[str]
    OpenRequested: NotRequired[_OpenRequestedPayload]
    TextCopied: NotRequired[str]
    FocusChanged: NotRequired[Optional[WidgetId]]
    SystemThemeChanged: NotRequired[SystemTheme]
    PowerStateChanged: NotRequired[_PowerStateChangedPayload]
    ScrollOffsetChanged: NotRequired[_ScrollOffsetChangedPayload]
    TextSelectionChanged: NotRequired[_TextSelectionChangedPayload]
    SplitDividerDragged: NotRequired[_SplitDividerDraggedPayload]
    MenuActivated: NotRequired[WidgetId]
    ContextMenuItemActivated: NotRequired[WidgetId]
    MessageDialogResolved: NotRequired[WidgetId]
    ToastActionClicked: NotRequired[WidgetId]
    CompletionItemActivated: NotRequired[Tuple[WidgetId, int]]
    RichTextLinkClicked: NotRequired[Tuple[WidgetId, str]]
    TrayClicked: NotRequired[_TrayClickedPayload]
    NotificationActivated: NotRequired[_NotificationActivatedPayload]
    Tree: NotRequired[Tuple[WidgetId, TreeEvent]]
    List: NotRequired[Tuple[WidgetId, ListViewEvent]]
    Form: NotRequired[Tuple[WidgetId, FormEvent]]
    Palette: NotRequired[Tuple[WidgetId, PaletteEvent]]
    TabBar: NotRequired[Tuple[WidgetId, TabBarEvent]]
    StatusBar: NotRequired[Tuple[WidgetId, StatusBarEvent]]
    ActivityBar: NotRequired[Tuple[WidgetId, ActivityBarEvent]]
    Terminal: NotRequired[Tuple[WidgetId, TerminalEvent]]
    TextDisplay: NotRequired[Tuple[WidgetId, TextDisplayEvent]]
    Chart: NotRequired[Tuple[WidgetId, ChartEvent]]
    DataTable: NotRequired[Tuple[WidgetId, DataTableEvent]]
    TreeTable: NotRequired[Tuple[WidgetId, TreeTableEvent]]
    Toolbar: NotRequired[Tuple[WidgetId, ToolbarEvent]]
    Canvas: NotRequired[Tuple[WidgetId, CanvasEvent]]
    BackendNative: NotRequired[BackendNativeEvent]
    User: NotRequired[Any]
    hit: NotRequired[HitDetail]  # The hit-tested sub-region a pointer landed on, when the binding attached one (never present on `User`).

# `isinstance(event, str)` (Python) / `typeof event === "string"` (TS) separates the three no-payload variants from the rest before narrowing on a key.
UiEvent = Union[Literal['WindowClose', 'DisplaysChanged', 'ContextMenuDismissed'], _UiEventDict]
