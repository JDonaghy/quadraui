    TreeTableController: NotRequired[Tuple[WidgetId, TreeTableControllerWireEvent]]  # A `TreeTableModel` (wire kind `"tree_table_controller"`) row, chevron or header interaction, naming rows by the app's node ids.
    CellGrid: NotRequired[Tuple[WidgetId, CellGridEvent]]  # A `crate::CellGrid` cell was clicked, moving the cursor to its absolute `(row, col)` — see `CellGridEvent::CursorMoved`.
    MultiSectionView: NotRequired[Tuple[WidgetId, MultiSectionViewEvent]]  # A `crate::MultiSectionView` header, divider, scrollbar or aux input was used, or one of its section bodies reported an event — see `crate::MultiSectionViewEvent`.
    Chat: NotRequired[Tuple[WidgetId, ChatEvent]]  # A `crate::Chat` was submitted, cancelled or clicked, or one of its controlled fields changed — see `crate::ChatEvent`.
    Sidebar: NotRequired[Tuple[WidgetId, SidebarAction]]  # A `crate::Sidebar` section, row or form field was used, or one of its controlled fields changed — see `crate::SidebarAction`.
    TabGroup: NotRequired[Tuple[WidgetId, TabGroupEvent]]  # A `crate::TabGroup` tab, divider or pane was used — see `crate::TabGroupEvent`.
    ScrollView: NotRequired[Tuple[WidgetId, ScrollViewEvent]]  # A `crate::ScrollView` resolved a wheel, key or scrollbar gesture to a new offset — see `crate::ScrollViewEvent`.
    Editor: NotRequired[Tuple[WidgetId, EditorEvent]]  # A pointer or wheel gesture on a `crate::Editor`, resolved against its layout — see `crate::EditorEvent`.
    Minimap: NotRequired[Tuple[WidgetId, MinimapEvent]]  # A click or drag on a `crate::Minimap` — see `crate::MinimapEvent`.
    Board: NotRequired[Tuple[WidgetId, BoardAction]]  # A key, click or context-menu request on a `crate::BoardModel` — see `crate::BoardAction`.
    PipelineView: NotRequired[Tuple[WidgetId, PipelineEvent]]  # A stage of a `crate::PipelineView` was focused, selected or activated — see `crate::PipelineEvent`.
    DiffView: NotRequired[Tuple[WidgetId, DiffViewEvent]]  # A `crate::DiffView` scrolled or moved focus between its panes — see `crate::DiffViewEvent`.
    MessageList: NotRequired[Tuple[WidgetId, MessageListEvent]]  # A `crate::MessageList` scrolled — see `crate::MessageListEvent`.
    FindReplace: NotRequired[Tuple[WidgetId, FindReplaceEvent]]  # A `crate::FindReplacePanel` field was edited, a switch flipped, or a match/replace/close action requested — see `crate::FindReplaceEvent`.
    HelpOverlay: NotRequired[Tuple[WidgetId, HelpOverlayAction]]  # A `crate::compose::HelpOverlay` cheatsheet asked to open or close; the host writes it onto the overlay's `open`.
    PathPicker: NotRequired[Tuple[WidgetId, PathPickerAction]]  # A `crate::compose::FilePicker` or `crate::compose::FolderPicker` confirmed a path, was dismissed, or asked the host to apply a browsing change.
    DualModePalette: NotRequired[Tuple[WidgetId, DualModePaletteAction]]  # A `crate::compose::DualModePalette` confirmed an item or text, was dismissed, or asked the host to apply a query, mode or highlight change.
    AppMenu: NotRequired[Tuple[WidgetId, AppMenuEvent]]  # A `crate::compose::AppMenu` opened, closed or moved within its cascade; the host applies the new view onto the menu.
    ShellView: NotRequired[Tuple[WidgetId, ShellEvent]]  # An app shell (`crate::ShellView`) resolved a gesture on its own chrome — a panel switch, a sidebar or bottom-panel resize or hide, a bottom activity item click.
    BottomPanel: NotRequired[Tuple[WidgetId, BottomPanelEvent]]  # A `crate::BottomPanel`'s tab strip activated or closed a tab, or toggled the panel maximised.
    Workspace: NotRequired[Tuple[WidgetId, WorkspaceEvent]]  # A `crate::Workspace` strip asked to activate, close or promote a document.
    Toolbar: NotRequired[Tuple[WidgetId, ToolbarEvent]]  # A `crate::Toolbar` button was clicked (mouse) or activated via Enter/Space while keyboard-focused — the id is the toolbar's own, matching every other chrome-bar variant above (`StatusBar`, `ActivityBar`); the clicked/activated button's own id and new `is_active` state are carried in the `ToolbarEvent` payload.
    Canvas: NotRequired[Tuple[WidgetId, CanvasEvent]]  # A `crate::Canvas`'s declared `crate::CanvasRegion` was clicked, double-clicked, or gained/lost pointer hover — the id is the canvas's own, matching every other primitive-specific variant above; which region (if any) is carried in the `CanvasEvent` payload.
    BackendNative: NotRequired[BackendNativeEvent]  # Backend-specific event the crate couldn't normalise.
    User: NotRequired[UserPayload]  # An app-defined value delivered from a background thread through `crate::Backend::waker`.

